<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Keep the platform DocumentsProvider contract: only DocumentsUI holds
        MANAGE_DOCUMENTS. Instrumentation requests a narrow fixture grant through
        provider-owned test IPC; the app under test never impersonates the provider.
    -->
    <application>
        <provider
            android:name="com.reader.app.saf.TestDocumentsProvider"
            android:authorities="com.reader.app.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:process=":saf_provider">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
